<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvNamaPengeluaran"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Keterangan pengeluaran"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDetailPengeluaran"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kategori - Jumlah - Tanggal"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEditPengeluaran"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit" />

        <Button
            android:id="@+id/btnHapusPengeluaran"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hapus" />

    </LinearLayout>

</LinearLayout>